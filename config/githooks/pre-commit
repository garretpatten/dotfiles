#!/bin/bash
# Pre-commit hook: scan staged changes with betterleaks for verified secrets.
# Installs betterleaks via dnf, yay, Homebrew, or go when missing. On Windows
# Git Bash/MSYS/Cygwin it delegates to the PowerShell implementation. Passes
# through gracefully when no supported package manager is available or when
# betterleaks encounters an execution error.

# On Windows Git Bash/MSYS/Cygwin, delegate to the PowerShell implementation.
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*)
    if command -v pwsh.exe >/dev/null 2>&1; then
      exec pwsh.exe -ExecutionPolicy Bypass -File "$(dirname "$0")/pre-commit.ps1"
    fi
    echo "Warning: running on Windows but pwsh.exe (PowerShell 7+) was not found. Skipping scan."
    exit 0
    ;;
esac

set -u

if ! command -v betterleaks >/dev/null 2>&1; then
  if dnf --version >/dev/null 2>&1; then
    echo "Pre-commit hook: installing betterleaks via dnf..."
    if ! sudo dnf install -y betterleaks >/dev/null 2>&1; then
      echo "Warning: dnf installation of betterleaks did not work as intended."
      exit 0
    fi
  elif yay --version >/dev/null 2>&1; then
    echo "Pre-commit hook: installing betterleaks via yay..."
    if ! yay -S --needed --noconfirm betterleaks >/dev/null 2>&1; then
      echo "Warning: yay installation of betterleaks did not work as intended."
      exit 0
    fi
  elif brew --version >/dev/null 2>&1; then
    echo "Pre-commit hook: installing betterleaks via Homebrew..."
    if ! brew install betterleaks >/dev/null 2>&1; then
      echo "Warning: Homebrew installation of betterleaks did not work as intended."
      exit 0
    fi
  elif go version >/dev/null 2>&1; then
    echo "Pre-commit hook: installing betterleaks via go..."
    if ! go install github.com/betterleaks/betterleaks@latest >/dev/null 2>&1; then
      echo "Warning: go installation of betterleaks did not work as intended."
      exit 0
    fi
    # Ensure the freshly installed binary is on PATH for the scan below.
    if [ -x "${HOME}/go/bin/betterleaks" ]; then
      export PATH="${HOME}/go/bin:${PATH}"
    fi
  else
    echo "Warning: betterleaks is not installed and no supported package manager (dnf/yay/brew) or go toolchain was found. Skipping scan."
    exit 0
  fi
fi

if ! command -v betterleaks >/dev/null 2>&1; then
  echo "Warning: betterleaks is not installed and could not be installed. Skipping scan."
  exit 0
fi

report_file="$(mktemp "${TMPDIR:-/tmp}/betterleaks-pre-commit.XXXXXX.json")"
stderr_file="$(mktemp "${TMPDIR:-/tmp}/betterleaks-pre-commit.XXXXXX.err")"
trap 'rm -f "$report_file" "$stderr_file"' EXIT

exit_code=0
betterleaks git . \
  --pre-commit \
  --staged \
  --validation \
  --validation-status valid \
  --report-format json \
  --report-path "$report_file" 2>"$stderr_file" || exit_code=$?

if [[ "$exit_code" -eq 0 ]]; then
  echo "Pre-commit hook: no verified secrets detected."
  exit 0
fi

if [[ -s "$report_file" ]]; then
  echo "Pre-commit hook failed: a verified secret was detected."
  echo "The secret must be removed before the commit can be made."
  echo "Affected file(s):"

  if command -v jq >/dev/null 2>&1; then
    jq -r '.[] | .Attributes.path // .Fragment.FilePath' "$report_file" | sort -u
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json, sys

with open(sys.argv[1]) as f:
    data = json.load(f)

paths = set()
for item in data:
    path = item.get("Attributes", {}).get("path") or item.get("Fragment", {}).get("FilePath")
    if path:
        paths.add(path)

for path in sorted(paths):
    print(path)
' "$report_file"
  else
    echo "Install jq or python3 to see the exact file path(s)."
  fi

  exit 1
fi

echo "Pre-commit hook: betterleaks did not run correctly."
if [[ -s "$stderr_file" ]]; then
  echo "Error output:"
  cat "$stderr_file"
fi
exit 0
