{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000,
  },
  "lsp": {
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"],
    },
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py"],
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash"],
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"],
    },
    "lua": {
      "command": ["lua-language-server"],
      "extensions": [".lua"],
    },
  },
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true,
      "oauth": {},
    },
  },
  "model": "opencode-go/glm-5.3-flash",
  "permission": {
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "df *": "allow",
      "du *": "allow",
      "env": "allow",
      "file *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "printenv": "allow",
      "ps *": "allow",
      "pwd": "allow",
      "rg *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "tree *": "allow",
      "uname *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "whoami": "allow",
    },
    "edit": "ask",
    "external_directory": {
      "*": "allow",
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "read": "allow",
  },
  "small_model": "opencode-go/glm-5.3-flash",
  "subagent_depth": 0,
}
