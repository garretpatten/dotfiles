{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000,
  },
  "lsp": {
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"],
    },
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py"],
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash"],
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"],
    },
    "lua": {
      "command": ["lua-language-server"],
      "extensions": [".lua"],
    },
  },
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true,
      "oauth": {},
    },
  },
  "model": "opencode-go/glm-5.3-flash",
  "permission": {
    "bash": {
      "*": "allow",
      "git push": "ask",
      "git push *": "ask",
      "git clean *": "ask",
      "git reset --hard*": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "mv *": "ask",
      "dd *": "ask",
      "shred *": "ask",
      "mkfs*": "ask",
      "truncate *": "ask",
      "sudo": "ask",
      "sudo *": "ask",
      "su": "ask",
      "su *": "ask",
      "doas *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "chgrp *": "ask",
      "chattr *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "npm install*": "ask",
      "npm uninstall*": "ask",
      "yarn add *": "ask",
      "yarn remove *": "ask",
      "pnpm add *": "ask",
      "pnpm remove *": "ask",
      "pip install*": "ask",
      "pip uninstall*": "ask",
      "cargo install*": "ask",
      "gem install*": "ask",
      "apt *": "ask",
      "apt-get *": "ask",
      "dnf *": "ask",
      "pacman *": "ask",
      "brew *": "ask",
      "shutdown *": "ask",
      "reboot *": "ask",
      "poweroff *": "ask",
      "halt *": "ask",
    },
    "edit": "allow",
    "external_directory": {
      "*": "allow",
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "read": "allow",
  },
  "small_model": "opencode-go/glm-5.3-flash",
  "subagent_depth": 0,
}
