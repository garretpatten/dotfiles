{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000,
  },
  "lsp": {
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"],
    },
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py"],
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash"],
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"],
    },
    "lua": {
      "command": ["lua-language-server"],
      "extensions": [".lua"],
    },
  },
  "mcp": {
    "servers": {
      "calendar": {
        "type": "remote",
        "url": "https://calendarmcp.googleapis.com/mcp/v1",
        "oauth": {
          "client_id": "YOUR_GOOGLE_CLIENT_ID",
          "client_secret": "YOUR_GOOGLE_CLIENT_SECRET",
          "scope": "https://www.googleapis.com/auth/calendar.calendarlist.readonly https://www.googleapis.com/auth/calendar.events.freebusy https://www.googleapis.com/auth/calendar.events.readonly https://www.googleapis.com/auth/calendar.events offline_access",
          "redirect_uri": "http://127.0.0.1:19876/callback",
          "callback_port": 19876,
        },
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "oauth": {},
      },
      "people": {
        "type": "remote",
        "url": "https://people.googleapis.com/mcp/v1",
        "oauth": {
          "client_id": "YOUR_GOOGLE_CLIENT_ID",
          "client_secret": "YOUR_GOOGLE_CLIENT_SECRET",
          "scope": "https://www.googleapis.com/auth/directory.readonly https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/contacts.readonly offline_access",
          "redirect_uri": "http://127.0.0.1:19876/callback",
          "callback_port": 19876,
        },
      },
      "tasks": {
        "type": "remote",
        "url": "https://tasksmcp.googleapis.com/mcp/v1",
        "oauth": {
          "client_id": "YOUR_GOOGLE_CLIENT_ID",
          "client_secret": "YOUR_GOOGLE_CLIENT_SECRET",
          "scope": "https://www.googleapis.com/auth/tasks.readonly https://www.googleapis.com/auth/tasks offline_access",
          "redirect_uri": "http://127.0.0.1:19876/callback",
          "callback_port": 19876,
        },
      },
    },
  },
  "model": "opencode-go/glm-5.3-flash",
  "permissions": [
    // Google Workspace MCP (official remote servers): allow reads, ask before writes.
    // V2 opencode registers MCP tools as permission actions "<server>_<tool>".
    { "action": "calendar_list_calendars", "resource": "*", "effect": "allow" },
    { "action": "calendar_list_events", "resource": "*", "effect": "allow" },
    { "action": "calendar_get_event", "resource": "*", "effect": "allow" },
    { "action": "calendar_search_events", "resource": "*", "effect": "allow" },
    { "action": "calendar_suggest_time", "resource": "*", "effect": "allow" },
    { "action": "calendar_create_event", "resource": "*", "effect": "ask" },
    { "action": "calendar_update_event", "resource": "*", "effect": "ask" },
    { "action": "calendar_delete_event", "resource": "*", "effect": "ask" },
    { "action": "calendar_respond_to_event", "resource": "*", "effect": "ask" },
    { "action": "people_get_user_profile", "resource": "*", "effect": "allow" },
    { "action": "people_search_contacts", "resource": "*", "effect": "allow" },
    { "action": "people_search_directory_people", "resource": "*", "effect": "allow" },
    { "action": "tasks_list_task_lists", "resource": "*", "effect": "allow" },
    { "action": "tasks_list_tasks", "resource": "*", "effect": "allow" },
    { "action": "tasks_get_task", "resource": "*", "effect": "allow" },
    { "action": "tasks_create_task", "resource": "*", "effect": "ask" },
    { "action": "tasks_update_task", "resource": "*", "effect": "ask" },
    { "action": "tasks_complete_task", "resource": "*", "effect": "ask" },
    { "action": "tasks_uncomplete_task", "resource": "*", "effect": "ask" },
    { "action": "tasks_delete_task", "resource": "*", "effect": "ask" },
    { "action": "tasks_undelete_task", "resource": "*", "effect": "ask" },
    // Shell: allow by default, ask before destructive or install commands.
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git push", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "shred *", "effect": "ask" },
    { "action": "shell", "resource": "mkfs*", "effect": "ask" },
    { "action": "shell", "resource": "truncate *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "sudo", "effect": "ask" },
    { "action": "shell", "resource": "su *", "effect": "ask" },
    { "action": "shell", "resource": "su", "effect": "ask" },
    { "action": "shell", "resource": "doas *", "effect": "ask" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "chown *", "effect": "ask" },
    { "action": "shell", "resource": "chgrp *", "effect": "ask" },
    { "action": "shell", "resource": "chattr *", "effect": "ask" },
    { "action": "shell", "resource": "curl *", "effect": "ask" },
    { "action": "shell", "resource": "wget *", "effect": "ask" },
    { "action": "shell", "resource": "npm install*", "effect": "ask" },
    { "action": "shell", "resource": "npm uninstall*", "effect": "ask" },
    { "action": "shell", "resource": "yarn add *", "effect": "ask" },
    { "action": "shell", "resource": "yarn remove *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm add *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm remove *", "effect": "ask" },
    { "action": "shell", "resource": "pip install*", "effect": "ask" },
    { "action": "shell", "resource": "pip uninstall*", "effect": "ask" },
    { "action": "shell", "resource": "cargo install*", "effect": "ask" },
    { "action": "shell", "resource": "gem install*", "effect": "ask" },
    { "action": "shell", "resource": "apt *", "effect": "ask" },
    { "action": "shell", "resource": "apt-get *", "effect": "ask" },
    { "action": "shell", "resource": "dnf *", "effect": "ask" },
    { "action": "shell", "resource": "pacman *", "effect": "ask" },
    { "action": "shell", "resource": "brew *", "effect": "ask" },
    { "action": "shell", "resource": "shutdown *", "effect": "ask" },
    { "action": "shell", "resource": "reboot *", "effect": "ask" },
    { "action": "shell", "resource": "poweroff *", "effect": "ask" },
    { "action": "shell", "resource": "halt *", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
  ],
  "small_model": "opencode-go/glm-5.3-flash",
  "subagent_depth": 0,
}
